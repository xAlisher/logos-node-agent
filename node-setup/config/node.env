# node.env — the ONE place to bump per release. Everything reads from here.
# Source of truth: the upstream release notes + docs
#   https://github.com/logos-blockchain/logos-blockchain/releases/latest
#   https://docs.logos.co/blockchain/get-started/run-a-logos-blockchain-node-from-cli
#
# The 0.2.1 node ships as the `blockchain_module` package installed via logoscore/lgpd/lgpm
# (the core tools are versioned 0.2.0; the blockchain MODULE is 0.2.1). This is the canonical,
# stranger-reproducible path — no raw binary, no dependence on our starter.

# ── module + tools versions (bump per release) ──
BLOCKCHAIN_MODULE_VERSION="0.2.2"     # 0.2.2 = current official release (wallet double-spend fix #3287)
# 0.2.2 is a patch release: it fixes the node-wallet UTXO double-spend under forky conditions that caused
#   v0.2.1 chain halts (logos-blockchain#3287). Wire-compatible with 0.2.1 (a 3-commit, wallet-only patch —
#   no network/interface/config changes), so 0.2.1 and 0.2.2 nodes interoperate. Confirmed downloadable in
#   the lgpd registry 2026-08-12 (Logos team). (LEZ/heavy-fee nodes may bump `pending_note_expiry_blocks`
#   10→120; a plain staking node keeps the default.)
# NB: install-node-tools.sh always fetches the CURRENT logoscore/lgpd/lgpm — this MODULE tag is what
# setup-node.sh pins. Bump BLOCKCHAIN_MODULE_VERSION, not CORE_TOOLS_TAG.
CORE_TOOLS_TAG="0.2.x"

# ── bootstrap peers — REFRESH FROM THE TARGET RELEASE'S NOTES EACH TIME ──
# (they rotate per release; the 0.2.1 notes list these four — note the 4th port is 50001, not 3003)
# ⚠ All four are ONE host (65.109.51.37) → single-host abort risk (#3166): if that host is unreachable the
# node can hard-abort. STRONGLY RECOMMENDED: add a diverse peer YOU control (e.g. another node over
# Tailscale) to EXTRA_PEERS below. We don't ship one — a good peer address is operator-specific and rotates.
BOOTSTRAP_PEERS='[
  "/ip4/65.109.51.37/udp/3000/quic-v1/p2p/12D3KooWFrouXfmrR4nsLMtE7wu15DoMJ6VtoUtHinREZCvbWHar",
  "/ip4/65.109.51.37/udp/3001/quic-v1/p2p/12D3KooWJRGau8M1rjT7R5e4YYsgdFhsMX35nRDtMwCDjxQkXAHz",
  "/ip4/65.109.51.37/udp/3002/quic-v1/p2p/12D3KooWQXJavMDTRscjauFSgVAB1VLB6Rzpy2uY5SU9Tk7927tb",
  "/ip4/65.109.51.37/udp/50001/quic-v1/p2p/12D3KooWSQc7CcGtvWDPF1yCbBthFnQjprfCVHmfmNDUrSmqQsU1"
]'
# Optional: extra diverse peers as a JSON fragment, e.g. ',"/ip4/…/udp/…/quic-v1/p2p/12D3Koo…"'
# (leading comma; leave empty to use only the four above). setup-node.sh splices this into the peer list.
EXTRA_PEERS="${EXTRA_PEERS:-}"

# ── local layout ──
NODE_HOME="${NODE_HOME:-$HOME/logos-node}"   # working dir: bin/, modules/, user_config.yaml, logs
API="${API:-http://localhost:8080}"          # node local API (api.backend.listen_address)
FAUCET_URL="https://testnet.blockchain.logos.co/web/faucet/"            # human web form (fallback)
FAUCET_BACKEND="https://testnet.blockchain.logos.co/web/faucet-backend" # POST <backend>/<pubkey> — used by fund-node.sh
